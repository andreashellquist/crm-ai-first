# Copy to .env for local development.

# The .NET API this frontend calls (backend/CrmApi). See backend/CrmApi/appsettings.Development.json
# for that project's own settings (its Postgres connection string, JWT secret, Anthropic key).
API_BASE_URL="http://localhost:5194"

# SCAFFOLD ONLY — Google sign-in (see src/app/api/auth/google/route.ts). The
# Client ID is not secret (it's sent to the browser in the redirect URL);
# the Client Secret lives only in backend/CrmApi/appsettings.Development.json's
# GoogleOAuth:ClientSecret, never here. Leave blank to leave Google sign-in
# disabled — the rest of the app works fine without it.
GOOGLE_CLIENT_ID=""
