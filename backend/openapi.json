    "components": {
        "schemas": {
            "ActivityDto": {
                "required": [
                    "id",
                    "type",
                    "body",
                    "createdAt"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "body": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "ContactDto": {
                "required": [
                    "id",
                    "firstName",
                    "lastName",
                    "email",
                    "companyName",
                    "lifecycleStage"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "lastName": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "email": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "companyName": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "lifecycleStage": {
                        "type": "string"
                    }
                }
            },
            "CreateContactRequest": {
                "required": [
                    "firstName",
                    "lastName",
                    "email",
                    "companyName"
                ],
                "type": "object",
                "properties": {
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "email": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "companyName": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "DealCardDto": {
                "required": [
                    "id",
                    "title",
                    "amountCents",
                    "currency",
                    "aiScore",
                    "aiScoreRationale"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "amountCents": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "currency": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "aiScore": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "aiScoreRationale": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "DealDetailDto": {
                "required": [
                    "id",
                    "title",
                    "stageName",
                    "amountCents",
                    "currency",
                    "aiScore",
                    "aiScoreRationale",
                    "contactNames",
                    "activities"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "stageName": {
                        "type": "string"
                    },
                    "amountCents": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int64"
                    },
                    "currency": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "aiScore": {
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                            "null",
                            "integer",
                            "string"
                        ],
                        "format": "int32"
                    },
                    "aiScoreRationale": {
                        "type": [
                            "null",
                            "string"
                        ]
                    },
                    "contactNames": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "activities": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ActivityDto"
                        }
                    }
                }
            },
            "JobStatusResponse": {
                "required": [
                    "status",
                    "lastError"
                ],
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "lastError": {
                        "type": [
                            "null",
                            "string"
                        ]
                    }
                }
            },
            "LogActivityRequest": {
                "required": [
                    "type",
                    "body"
                ],
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "body": {
                        "type": "string"
                    }
                }
            },
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                }
            },
            "LoginResponse": {
                "required": [
                    "token",
                    "workspaceId",
                    "workspaceName"
                ],
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "workspaceId": {
                        "type": "string"
                    },
                    "workspaceName": {
                        "type": "string"
                    }
                }
            },
            "MoveDealRequest": {
                "required": [
                    "stageId"
                ],
                "type": "object",
                "properties": {
                    "stageId": {
                        "type": "string"
                    }
                }
            },
            "PipelineBoardDto": {
                "required": [
                    "id",
                    "name",
                    "stages"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "stages": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/StageDto"
                        }
                    }
                }
            },
            "ScoreDealResponse": {
                "required": [
                    "jobId"
                ],
                "type": "object",
                "properties": {
                    "jobId": {
                        "type": "string"
                    }
                }
            },
            "StageDto": {
                "required": [
                    "id",
                    "name",
                    "deals"
                ],
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "deals": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DealCardDto"
                        }
                    }
                }
            }
        }
